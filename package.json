{
  "name": "be-fetching",
  "version": "0.0.23",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "fetch"
  ],
  "description": "fetch data from a url.",
  "main": "be-fetching.js",
  "module": "be-fetching.js",
  "exports": {
    ".": "./be-fetching.js",
    "./be-fetching.js": "./be-fetching.js"
  },
  "files": [
    "*.js",
    "./ts-refs/be-fetching/types.d.ts",
    "README.md",
    "demo/*.*"
  ],
  "types": "./ts-refs/be-fetching/types.d.ts",
  "scripts": {
    "test": "playwright test",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "be-enhanced": "0.0.189",
    "be-hive": "0.0.267",
    "mount-observer": "0.0.105",
    "trans-render": "0.0.960"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "spa-ssi": "0.0.23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-fetching.git"
  },
  "author": "anderson.bruce.b@gmail.com",
